{
  "name": "payroll",
  "version": "0.1.0",
  "private": true,
  "description": "A modern payroll management application built with Next.js, Prisma, PostgreSQL, and Clerk authentication. This system provides comprehensive employee management, attendance tracking, leave management, and payroll processing capabilities.",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "prettier-fix": "prettier --write .",
    "prettier": "prettier --check .",
    "format:staged": "prettier --write --ignore-unknown",
    "seed": "npx tsx prisma/seed.ts",
    "seed:roles": "node --loader ts-node/esm prisma/seed-roles.mts",
    "seed:all": "npm run seed",
    "logs:clean": "rm -rf logs/*.log logs/*.log.*",
    "logs:view": "tail -f logs/app-*.log",
    "logs:errors": "tail -f logs/error-*.log",
    "prepare": "husky",
    "db:migrate": "npx prisma migrate deploy",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "db:backup": "./scripts/backup.sh",
    "deploy:prod": "./scripts/deploy.sh production",
    "docker:build": "docker build -t trinits-payroll .",
    "docker:run": "docker run -p 3000:3000 trinits-payroll",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker-compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker-compose -f docker-compose.prod.yml logs -f payroll-app"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@heroicons/react": "^2.2.0",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.9.0",
    "@reduxjs/toolkit": "^2.8.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pdfkit": "^0.14.0",
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.10.3",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "library-name": "^1.1.0",
    "lucide-react": "^0.530.0",
    "next": "^15.4.6",
    "next-auth": "^4.24.11",
    "pdfkit": "^0.17.1",
    "react": "^19.1.1",
    "react-calendar": "^6.0.0",
    "react-dom": "^19.1.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.7.0",
    "react-toastify": "^11.0.5",
    "recharts": "^2.15.3",
    "resend": "^4.6.0",
    "svix": "^1.67.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/file-saver": "^2.0.7",
    "@types/next-auth": "^3.13.0",
    "@types/node": "^20",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-toastify": "^4.0.2",
    "@types/winston": "^2.4.4",
    "@types/xlsx": "^0.0.35",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "postcss": "^8.5.6",
    "postcss-preset-env": "^10.2.4",
    "prettier": "^3.6.1",
    "prisma": "^6.9.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "prisma": {
    "seed": "node --loader ts-node/esm prisma/seed.mts"
  },
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trinits-technologies/payroll.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/trinits-technologies/payroll/issues"
  },
  "homepage": "https://github.com/trinits-technologies/payroll#readme"
}
