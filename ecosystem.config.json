{
  "apps": [
    {
      "name": "trinits-payroll",
      "script": "npm",
      "args": "start",
      "cwd": "/var/www/trinits-payroll",
      "instances": "max",
      "exec_mode": "cluster",
      "watch": false,
      "max_memory_restart": "1G",
      "env": {
        "NODE_ENV": "production",
        "PORT": "3000"
      },
      "env_production": {
        "NODE_ENV": "production",
        "PORT": "3000"
      },
      "log_date_format": "YYYY-MM-DD HH:mm Z",
      "error_file": "/var/log/pm2/trinits-payroll-error.log",
      "out_file": "/var/log/pm2/trinits-payroll-out.log",
      "log_file": "/var/log/pm2/trinits-payroll.log",
      "merge_logs": true,
      "time": true,
      "autorestart": true,
      "restart_delay": 1000,
      "max_restarts": 10,
      "min_uptime": "10s",
      "kill_timeout": 5000,
      "wait_ready": true,
      "listen_timeout": 3000,
      "shutdown_with_message": true
    }
  ]
}
